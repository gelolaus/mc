generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Player {
  id String @id @default(cuid())
  minecraftUuid String @unique
  username String
  firstJoinedAt DateTime
  lastJoinedAt DateTime
  lastSeenAt DateTime
  playtimeSeconds Int @default(0)
  sessionCount Int @default(0)
  online Boolean @default(false)
  skinTextureHash String?
  currentServerKey String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([username])
  @@index([firstJoinedAt])
}
model ServerState {
  serverKey String @id
  displayName String
  version String?
  playersOnline Int @default(0)
  playersMax Int @default(0)
  serverStartedAt DateTime?
  lastHeartbeatAt DateTime?
  stoppedAt DateTime?
  updatedAt DateTime @updatedAt
}
model World {
  id Int @id @default(1)
  createdAt DateTime
  displayName String @default("Our World")
}
